# Optional. Leave everything empty to run in demo mode (data kept in the browser).
# Fill all of these from Firebase console > Project settings > Your apps > Web app
# to switch the app to Firebase Auth + Cloud Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "demo" to force demo mode even when the Firebase variables are present.
VITE_BACKEND=
